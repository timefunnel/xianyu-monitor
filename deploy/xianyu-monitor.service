[Unit]
Description=Xianyu keyword monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际路径修改
WorkingDirectory=/opt/xianyu-monitor
# 监控本身不启浏览器（http 模式），所以它并不需要图形界面；这里保留 xvfb-run 是为了：
#   1) 万一你把 search.mode 回退成 browser；
#   2) 「点开看商品」要在带登录态的浏览器里打开时不会被 DISPLAY 缺失拦住。
# 想省掉 Xvfb 可以直接把 ExecStart 改成 /usr/bin/node src/cli.mjs run。
ExecStart=/usr/bin/xvfb-run -a /usr/bin/node src/cli.mjs run
Restart=always
RestartSec=10
# 只给必要的写权限：data 目录需要可写，其余只读
ReadWritePaths=/opt/xianyu-monitor/data
Environment=NODE_ENV=production
# 通知里的时间按这个时区显示；服务器通常是 UTC，不设会看到差 8 小时的时间戳。
Environment=TZ=Asia/Shanghai
# 钉钉/企业微信等渠道的密钥放在 .env，由程序自己读取
# EnvironmentFile=/opt/xianyu-monitor/.env

[Install]
WantedBy=multi-user.target
